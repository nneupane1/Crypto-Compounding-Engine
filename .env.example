# Copy to .env on the server. Do not commit real secrets.

TZ=Europe/Berlin

# Runtime cadence
RTS_SCHEDULER_INTERVAL_SECONDS=300
RTS_RUN_AT_START=true
RTS_DASHBOARD_PUBLIC_VISUAL_EXTENSION=true

# Bind locally by default. Put a reverse proxy/TLS/auth in front before exposing.
RTS_DASHBOARD_BIND=127.0.0.1:3000
RTS_DASHBOARD_API_BIND=127.0.0.1:8000

# Alert emails
RTS_ALERT_EMAIL_TO=nneupane1@gmail.com
RTS_ALERT_EMAIL_ENABLED=false
RTS_ALERT_EMAIL_DRY_RUN=true
RTS_ALERT_EMAIL_FROM=
RTS_ALERT_SMTP_HOST=
RTS_ALERT_SMTP_PORT=587
RTS_ALERT_SMTP_USERNAME=
RTS_ALERT_SMTP_PASSWORD=

# Binance Spot Testnet demo only. Leave disabled unless intentionally testing demo execution.
WALK_FORWARD_DEMO_EXECUTION_ENABLED=false
BINANCE_DEMO_API_KEY=
BINANCE_DEMO_API_SECRET=

# Production/mainnet keys are intentionally not part of this deployment yet.
BINANCE_API_KEY=
BINANCE_API_SECRET=

# Dedicated Binance Spot mainnet keys for guarded tiny smoke/canary tests only.
# These must be IP-restricted to the Hetzner server and must have withdrawals disabled.
BINANCE_LIVE_SMOKE_API_KEY=
BINANCE_LIVE_SMOKE_API_SECRET=

# Guarded live-canary defaults. This is not full live trading.
RTS_LIVE_CANARY_SYMBOL_ALLOWLIST=ADAUSDT,LINKUSDT,BNBUSDT,XRPUSDT,AVAXUSDT,DOGEUSDT,ETHUSDT,BTCUSDT,SOLUSDT
RTS_LIVE_CANARY_MAX_ACCOUNT_CAPITAL_EUR=100
RTS_LIVE_CANARY_MAX_TEST_BUDGET_EUR=50
RTS_LIVE_CANARY_MAX_ORDER_NOTIONAL_EUR=10
RTS_LIVE_CANARY_MAX_DAILY_LOSS_EUR=10
RTS_LIVE_CANARY_MAX_OPEN_POSITIONS=1
RTS_LIVE_CANARY_LOOKBACK_HOURS=168
RTS_LIVE_CANARY_ENABLED=false
RTS_LIVE_CANARY_CONFIRM=
RTS_LIVE_CANARY_I_UNDERSTAND_MAX_LOSS=
